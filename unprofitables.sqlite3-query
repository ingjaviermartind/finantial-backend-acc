SELECT 
    dept.name AS Departamento,
    mun.name AS Municipio,
    mun.dane AS Dane,
    mun.node AS Nodo,
    mun.unprofitable
FROM Backend_municipality mun
LEFT JOIN Backend_department dept
ON mun.department_id = dept.id
WHERE unprofitable = 1
ORDER BY Departamento ASC, Municipio ASC;


